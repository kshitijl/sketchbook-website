{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "31-art-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Workers Cache: a cache that sits in front of the Worker itself, so a hit is served without
	// the Worker running at all. This is the mechanism that actually makes pages cached — ordinary
	// zone-level Cache Rules only apply to a Worker's fetch() to an external origin, never to a
	// Worker generating its own responses (our case, confirmed by a failing check-caching.mjs run
	// against production despite a correctly-configured Cache Rule). Requires wrangler >= 4.69.0.
	// Respects the existing Cache-Control headers already set per-page with no code changes, and
	// automatically skips "no-store" admin routes. Purging it requires cache.purge() called from
	// inside the Worker (see src/lib/purge.ts) — no zone-level purge reaches this cache at all.
	"cache": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "ART_BUCKET",
			"bucket_name": "31-art-website-data"
		},
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "31-art-website-backups"
		}
	],
	// Explicit on purpose: the Astro Cloudflare adapter regenerates its own deploy-time config
	// (dist/server/wrangler.json) from this file and does NOT carry through a "routes" field —
	// tested and confirmed. The custom domain is attached via `wrangler deploy --domain
	// klauria.art` instead (see docs/TODO.md for the current blocker on that). Keeping
	// workers_dev explicit here means it can never be silently disabled by an unrelated flag
	// the way it was on a `--domain` deploy attempt that then failed (a real incident during
	// setup — the site went down until this was made explicit and redeployed).
	"workers_dev": true
}