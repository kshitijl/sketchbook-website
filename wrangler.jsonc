{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "31-art-website",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Workers Cache: a cache that sits in front of the Worker itself, so a hit is served without
	// the Worker running at all. This is the mechanism that actually makes pages cached — ordinary
	// zone-level Cache Rules only apply to a Worker's fetch() to an external origin, never to a
	// Worker generating its own responses (our case, confirmed by a failing check-caching.mjs run
	// against production despite a correctly-configured Cache Rule). Requires wrangler >= 4.69.0.
	// Respects the existing Cache-Control headers already set per-page with no code changes, and
	// automatically skips "no-store" admin routes. Purging it requires cache.purge() called from
	// inside the Worker (see src/lib/purge.ts) — no zone-level purge reaches this cache at all.
	"cache": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "ART_BUCKET",
			"bucket_name": "31-art-website-data"
		},
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "31-art-website-backups"
		}
	],
	// SECURITY, not preference. Cloudflare Access is configured on the hostname pattern
	// `klauria.art/admin*`, so it does not cover `31-art-website.workers.dev` — with workers_dev
	// on, every `/admin/*` route was reachable there with no authentication at all. Found live on
	// 2026-07-30 (see docs/TODO.md). The custom domain is attached separately and is unaffected by
	// this flag, so turning it off removes the unprotected hostname without touching klauria.art.
	// Historical note, still true: the Astro Cloudflare adapter regenerates its own deploy-time
	// config (dist/server/wrangler.json) from this file and does not carry through a "routes"
	// field, and an earlier `--domain` deploy attempt once silently flipped this off and took the
	// site down back when workers.dev *was* the site. Keeping it explicit is what makes either
	// value deliberate.
	"workers_dev": false
}