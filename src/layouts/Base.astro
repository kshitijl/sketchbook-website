---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			:root {
				color-scheme: light dark;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;

				--bg: #faf5f2;
				--bg-alt: #f3e8f7;
				--text: #2b2230;
				--text-muted: #6b5f72;
				--accent: #8b5cf6;
				--accent-2: #ec4899;
				--accent-3: #f87171;
				--border: #e4d5ec;
				--radius: 8px;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #1e1823;
					--bg-alt: #2b2233;
					--text: #f2e9f5;
					--text-muted: #b9a9c2;
					--accent: #c4a3ff;
					--accent-2: #f9a8d4;
					--accent-3: #fca5a5;
					--border: #453a4f;
				}
			}

			* {
				box-sizing: border-box;
			}
			body {
				margin: 0 auto;
				max-width: 60rem;
				padding: 1.5rem;
				line-height: 1.6;
				background: var(--bg);
				color: var(--text);
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
				padding-bottom: 1rem;
				border-bottom: 2px solid var(--border);
			}
			nav a {
				padding: 0.35rem 0.85rem;
				border-radius: 999px;
				background: var(--bg-alt);
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.9rem;
			}
			nav a:hover {
				background: var(--accent);
				color: white;
			}

			h1,
			h2,
			h3 {
				font-weight: 700;
				letter-spacing: -0.01em;
			}
			h1 {
				color: var(--accent);
			}
			h2 {
				color: var(--text);
				border-left: 4px solid var(--accent-2);
				padding-left: 0.6rem;
			}

			a {
				color: var(--accent-2);
			}
			a:hover {
				color: var(--accent);
			}

			em {
				color: var(--text-muted);
			}

			button,
			input[type='submit'] {
				background: var(--accent);
				color: white;
				border: none;
				padding: 0.5rem 1rem;
				border-radius: var(--radius);
				font-weight: 600;
				font: inherit;
				cursor: pointer;
			}
			button:hover,
			input[type='submit']:hover {
				background: var(--accent-2);
			}

			input[type='text'],
			input[type='date'],
			input[type='number'],
			input[type='email'],
			textarea,
			select {
				border: 1px solid var(--border);
				border-radius: var(--radius);
				padding: 0.45rem 0.6rem;
				background: var(--bg-alt);
				color: var(--text);
				font: inherit;
			}

			.tag-chip {
				background: var(--bg-alt);
				color: var(--accent);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.3rem 0.7rem;
				font-size: 0.85rem;
				font-weight: 600;
			}
			.tag-chip:hover {
				background: var(--accent-2);
				color: white;
				border-color: var(--accent-2);
			}

			img {
				border-radius: var(--radius);
			}

			figure {
				margin: 0 0 1rem 0;
			}
			figcaption {
				color: var(--text-muted);
				font-size: 0.85rem;
			}

			details summary {
				cursor: pointer;
				color: var(--accent);
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<nav>
			<a href="/">Home</a>
			<a href="/timeline">Timeline</a>
			<a href="/map">Map</a>
			<a href="/browse">Browse</a>
			<a href="/admin">Admin</a>
		</nav>
		<slot />
	</body>
</html>
