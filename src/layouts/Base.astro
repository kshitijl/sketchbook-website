---
interface Props {
	title: string;
	/** Open Graph/Twitter description. Falls back to a generic site description. */
	description?: string;
	/** Open Graph/Twitter image — must be an absolute URL (relative ones aren't valid OG images). */
	image?: string;
	/** For /embed/* pages, framed inside other sites: no header or debug footer, and links open in
	 * a new tab instead of inside the frame. */
	bare?: boolean;
}
const { title, description = "I draw and paint from life, in a sketchbook. It's how I look at things.", image, bare = false } =
	Astro.props;

// Debug footer: if reloading the same URL keeps showing the same renderId, that request was
// served from Cloudflare's edge cache, not re-rendered by the Worker. See docs/architecture.md's
// Cache policy section. renderId is a fresh crypto.randomUUID() generated only when this code
// actually runs — unlike a timestamp, two genuinely separate renders can't collide on it, which
// is what makes it a reliable signal for the automated caching check in docs/TODO.md. `cf` is a
// Cloudflare-specific Request extension — absent under plain `astro dev`, present (real or
// emulated) under wrangler dev / deployed.
const renderedAt = new Date().toISOString();
const renderId = crypto.randomUUID();
const colo = (Astro.request as { cf?: { colo?: string } }).cf?.colo ?? 'local';
// Substituted at build time by Vite's `define` (see astro.config.mjs). `renderedAt` above says
// when this HTML was generated; these say which build generated it — the pair is what tells you
// whether a stale-looking page is a cache artifact or just old code still deployed.
const deployedAt = __BUILD_TIME__;
const deployedCommit = __BUILD_COMMIT__;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{image && <meta property="og:image" content={image} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		{bare && <base target="_blank" />}
		<style is:global>
			:root {
				color-scheme: light;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
				--mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

				--bg: #ffffff;
				--panel: #ffffff;
				--text: #141414;
				--text-muted: #6b6b6b;
				--border: #141414;
				--pink: #ff3d8f;
				--purple: #7c5cff;
				/* One shared gutter for the whole page — text and the full-bleed gallery images
				   must use the exact same inset or they visibly don't line up on their left edge
				   (confirmed against juddmercer.art's own CSS: a single `--pagePadding` variable
				   drives both its header and its content sections the same way). */
				--gutter: 6vw;
			}
			* {
				box-sizing: border-box;
			}
			body {
				/* max-width was 64rem (1024px) — on any screen wider than that (i.e. most
				   desktops/laptops), the auto-centered body sat inset from the real viewport edge
				   by (screen width − 1024px)/2, on top of the gutter padding below, while the
				   full-bleed gallery images (.piece-grid.large) correctly stay inset by only the
				   gutter — a real, growing misalignment between the text and the art's left edge
				   confirmed by both the math and juddmercer.art's own CSS: their maxPageWidth is
				   1920px specifically so this never triggers on a real screen. Matching that. */
				margin: 0 auto;
				max-width: 1920px;
				padding: var(--gutter);
				line-height: 1.5;
				background: var(--bg);
				color: var(--text);
			}

			/* Compact header: a small site title and a hamburger toggle, nothing else — the images
			   are the priority, not a big heading and a full nav bar sitting above the fold. The
			   toggle is a plain checkbox/label pair (no JS) so clicking it reveals the actual nav
			   links as a small dropdown panel instead of them all being visible by default. */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				position: relative;
				margin-bottom: 1rem;
			}
			.site-title {
				font-family: var(--mono);
				text-transform: uppercase;
				font-weight: 700;
				font-size: 0.85rem;
				letter-spacing: 0.05em;
				color: var(--text);
				text-decoration: none;
			}
			.nav-toggle {
				position: absolute;
				opacity: 0;
				width: 2rem;
				height: 2rem;
				top: 0;
				right: 0;
				margin: 0;
				cursor: pointer;
			}
			.nav-toggle-label {
				display: flex;
				flex-direction: column;
				gap: 4px;
				padding: 0.25rem;
			}
			.nav-toggle-label span {
				display: block;
				width: 22px;
				height: 2px;
				background: var(--text);
			}
			nav {
				display: none;
				flex-direction: column;
				position: absolute;
				top: 100%;
				right: 0;
				min-width: 10rem;
				background: var(--panel);
				border: 2px solid var(--border);
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.05em;
				z-index: 10;
			}
			.nav-toggle:checked ~ nav {
				display: flex;
			}
			nav a {
				padding: 0.6rem 1rem;
				color: var(--text);
				text-decoration: none;
				font-weight: 700;
				border-bottom: 2px solid var(--border);
				white-space: nowrap;
			}
			nav a:last-child {
				border-bottom: none;
			}
			nav a:hover {
				background: var(--pink);
				color: white;
			}

			h1 {
				font-weight: 700;
				font-size: 1rem;
				text-transform: uppercase;
				letter-spacing: 0.02em;
				margin: 0 0 0.75rem 0;
			}
			h2 {
				display: inline-block;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				background: var(--border);
				color: var(--bg);
				padding: 0.25rem 0.6rem;
				margin-bottom: 0.75rem;
			}

			section {
				border: 2px solid var(--border);
				background: var(--panel);
				padding: 1rem;
				margin-bottom: 1.5rem;
			}

			a {
				color: var(--purple);
			}
			a:hover {
				color: var(--pink);
			}

			em {
				color: var(--text-muted);
				font-style: normal;
				font-family: var(--mono);
				font-size: 0.85rem;
			}

			button,
			input[type='submit'] {
				background: var(--text);
				color: var(--bg);
				border: 2px solid var(--border);
				padding: 0.5rem 1rem;
				font-weight: 700;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				cursor: pointer;
			}
			button:hover,
			input[type='submit']:hover {
				background: var(--pink);
				border-color: var(--pink);
				color: white;
			}

			input[type='text'],
			input[type='date'],
			input[type='number'],
			input[type='email'],
			textarea,
			select {
				border: 2px solid var(--border);
				padding: 0.45rem 0.6rem;
				background: var(--panel);
				color: var(--text);
				font: inherit;
			}

			/* Drop target for dragging images straight from Photos/Finder (see pieceForm.ts). */
			.dropzone {
				border: 2px dashed var(--border);
				padding: 1rem;
			}
			.dropzone.dragover {
				background: var(--pink);
				color: white;
			}

			.tag-chip {
				background: var(--panel);
				color: var(--text);
				border: 2px solid var(--border);
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.3rem 0.6rem;
			}
			/* Gated to devices with a real, non-touch pointer: without this, tapping a chip on mobile
			   to deselect it leaves the browser's simulated :hover "stuck" on (no mouseout ever
			   fires from a tap) — since it looked identical to .selected, a just-deselected chip
			   still looked selected until you tapped elsewhere. Desktop hover is unaffected.
			   Deliberately a lighter outline, not the solid fill .selected uses below, so hovering a
			   chip never looks like it's already selected. */
			@media (hover: hover) and (pointer: fine) {
				.tag-chip:hover {
					background: var(--panel);
					color: var(--purple);
					border-color: var(--purple);
				}
			}
			.tag-chip.selected {
				/* Solid fill, persistent — the admin form's tag chips toggle this class on/off to
				   show which tags are currently in the tags box, since once it has enough tags to
				   overflow, you lose visual track of what's already in there. */
				background: var(--purple);
				color: white;
				border-color: var(--purple);
			}

			/* Image-forward card grid — shared by PieceList.astro and any page (e.g. /kind/[kind])
			   that needs the same big-image treatment but a different underlying data shape, so
			   it's global CSS keyed by class name rather than scoped to one component. */
			.piece-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
				gap: 0.75rem;
			}
			.piece-grid.large {
				/* Breaks out of the page's centered/padded container (this body's own max-width)
				   so the art is as big as the screen allows, not confined to the reading-width
				   column the rest of the page uses — but keeps the same shared `--gutter` on each
				   side (see :root) rather than running truly edge-to-edge, so the image's left
				   edge lines up with the page's text instead of sitting further out than it. Not
				   wrapped in a bordered <section>, so it needs its own bottom margin to match that
				   spacing. Auto-fit at a wide minimum means it's one huge piece per row on
				   narrow/mobile screens, but naturally settles into 2-3 per row on a wide desktop
				   window. `min(480px, 100%)` is the important part on mobile — a bare 480px
				   minimum is wider than most phone screens, which forced the whole grid (and the
				   image in it) past the edge of the viewport, needing a horizontal scroll to see
				   the rest of it. Capping the minimum at 100% of the container means it never asks
				   for more space than it has. */
				grid-template-columns: repeat(auto-fit, minmax(min(480px, 100%), 1fr));
				gap: 3rem;
				margin-bottom: 1.5rem;
				width: calc(100vw - 2 * var(--gutter));
				position: relative;
				left: 50%;
				margin-left: calc(-50vw + var(--gutter));
			}
			.piece-grid.large.hero-first > li:first-child {
				/* Only the page's actual opening gallery gets this (see the `heroFirst` prop on
				   PieceList.astro) — applying it to every big-image batch on the page made later
				   batches look broken/inconsistent (their first piece randomly huge, the rest
				   small) rather than reading as a deliberate one-time opening beat. */
				grid-column: 1 / -1;
			}
			.piece-grid a {
				display: block;
				color: var(--text);
				text-decoration: none;
			}
			.piece-grid img {
				display: block;
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover;
			}
			.piece-grid.large img {
				/* Full artwork at its own proportions, not force-cropped to a square. Same
				   max-height cap as /piece/[id] and the map's inline detail panel — without it, a
				   tall/portrait image stretched to fill a wide desktop column (especially a
				   single-image row, e.g. the home page's "random pick" sections) could render many
				   multiples of the viewport's height, forcing a scroll to see the whole thing. */
				aspect-ratio: auto;
				width: auto;
				height: auto;
				max-width: 100%;
				max-height: 85vh;
				object-fit: contain;
				margin: 0 auto;
			}
			.piece-grid .caption {
				display: block;
				margin-top: 0.35rem;
				font-family: var(--mono);
				font-size: 0.7rem;
				text-transform: uppercase;
				color: var(--text-muted);
			}
			.piece-grid.large .caption {
				padding: 0 var(--gutter);
			}

			/* Home-page image carousel (Carousel.astro): one big piece at a time, arrows flank a
			   scroll-snap track (native swipe works too, wired in carousel.ts). Full-bleed like the
			   old grids so the art stays large. */
			.carousel {
				margin-bottom: 1.5rem;
				width: calc(100vw - 2 * var(--gutter));
				position: relative;
				left: 50%;
				margin-left: calc(-50vw + var(--gutter));
			}
			.carousel-track {
				display: flex;
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				list-style: none;
				margin: 0;
				padding: 0;
				scrollbar-width: none; /* hide the scrollbar — the arrows/swipe are the controls */
			}
			.carousel-track::-webkit-scrollbar {
				display: none;
			}
			.carousel-slide {
				flex: 0 0 100%;
				scroll-snap-align: center;
			}
			.carousel-slide a {
				display: block;
				text-align: center;
				text-decoration: none;
				color: var(--text);
			}
			/* A fixed-height "room" the piece sits centred in — so a landscape and a portrait piece
			   occupy the same vertical space and the caption below always lands in the same place,
			   instead of the caption riding up under a short landscape image. */
			.carousel-image {
				display: flex;
				align-items: center;
				justify-content: center;
				height: 70vh;
			}
			.carousel-image img {
				display: block;
				max-width: 100%;
				max-height: 100%;
				width: auto;
				height: auto;
			}
			.carousel-caption {
				display: block;
				margin-top: 0.5rem;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.7rem;
				color: var(--text-muted);
			}
			.carousel-title {
				display: block;
			}
			/* The "click to explore →" line — coloured like a link so it reads as interactive. */
			.carousel-hint {
				display: block;
				margin-top: 0.25rem;
				color: var(--purple);
			}
			/* Arrows sit in a row *under* the image (not flanking it), so the image gets the full
			   width — matters most for landscape pieces on mobile. */
			.carousel-nav {
				display: flex;
				justify-content: center;
				gap: 1rem;
				margin-top: 0.75rem;
			}
			.carousel-prev,
			.carousel-next {
				font-size: 1.3rem;
				padding: 0.4rem 1.4rem;
			}
			/* Dimmed + inert at the ends of the track (toggled in carousel.ts), so it's clear there's
			   nothing further that way. */
			.carousel-prev:disabled,
			.carousel-next:disabled {
				opacity: 0.25;
				cursor: default;
				pointer-events: none;
			}

			/* Small quiet label above a home-page gallery batch (favorites/recent/random) — same
			   quiet mono/uppercase voice as .piece-grid .caption, not a heavy heading, so it orients
			   a scrolling viewer without competing with the images for attention. */
			.section-label {
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				color: var(--text-muted);
				margin: 1.5rem 0 0.35rem;
			}

			/* Top-5 painting months, under the lifetime counter at the very bottom of the home page.
			   Deliberately small and quiet like that counter — it's a stat the owner wants to look at,
			   not something a visitor needs. `width: auto` because a three-column table of tiny numbers
			   stretched across a 1920px body reads as an empty expanse with digits at either end. */
			.month-ranks {
				border-collapse: collapse;
				font-size: 0.85rem;
				color: var(--text-muted);
				/* `width: auto` + `margin: auto` — the table is only as wide as its own contents, so
				   centering it means centering that narrow block, not stretching it across the page. */
				margin: 0 auto 2rem;
			}
			.month-ranks caption {
				font-style: italic;
				padding-bottom: 0.4rem;
			}
			.month-ranks th,
			.month-ranks td {
				text-align: left;
				padding: 0.25rem 1.25rem 0.25rem 0;
				font-weight: normal;
			}
			.month-ranks thead th {
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.7rem;
				border-bottom: 1px solid var(--text-muted);
			}
			/* The current month's row. A background tint alone would be the obvious way to mark it, but
			   the palette is a near-white page — a tint light enough not to fight the page is too light
			   to notice on its own, so this leans on weight and a left bar as well. */
			.month-ranks .is-current {
				background: #fff0f6; /* faintest wash of --pink */
				color: var(--text);
				font-weight: 600;
			}
			.month-ranks .is-current td:first-child {
				box-shadow: inset 3px 0 0 var(--pink);
				padding-left: 0.5rem;
			}

			/* Timeline activity bar chart (built server-side in index.astro): a row of year bars by
			   default, each a vertical flex stack of medium-colored segments that pile up from the
			   baseline; clicking a year swaps in its own row of at most 12 month bars. Both rows are
			   naturally bounded (years grow by one a year; a drilled-in row is never more than 12),
			   so equal-width flex bars stay comfortably tappable regardless of how much history piles
			   up — unlike one flat row of every month ever, which only gets thinner with each passing
			   year. Segment colors are a validated categorical pair (blue = wet media, sepia = dry
			   media) plus a neutral for "other" — see the dataviz palette check in the timeline work. */
			.timeline-hidden {
				display: none;
			}
			.timeline-chart {
				display: flex;
				align-items: flex-end;
				gap: 2px;
				height: var(--chart-h);
				margin: 0.5rem 0 0;
				border-bottom: 2px solid var(--border);
			}
			.timeline-bar {
				/* Override the global dark filled-button style — a bar is a transparent track that
				   holds the colored fills, not a button-looking box. */
				flex: 1;
				min-width: 0;
				height: 100%;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				gap: 2px;
				padding: 0;
				background: transparent;
				border: none;
				cursor: pointer;
			}
			.timeline-bar:hover:not(:disabled) {
				/* Highlight the whole month column on hover, not just the filled part. */
				background: rgba(20, 20, 20, 0.07);
			}
			.timeline-bar.selected {
				background: rgba(20, 20, 20, 0.07);
				outline: 2px solid var(--pink);
				outline-offset: -2px;
			}
			.timeline-bar:disabled {
				/* Same pointer as any other bar — only the hover tint below (not the cursor) marks
				   it as empty. A "not-allowed" stop-sign cursor read as too harsh/jarring here. */
				cursor: pointer;
			}
			.timeline-bar:disabled:hover {
				/* Without this, an empty bar's hover falls through to the global button:hover's
				   electric pink (that rule isn't scoped off disabled buttons) — confusing, since
				   pink elsewhere always means "selected"/interactive. A dimmer, plain gray tint
				   still confirms the hover registered without implying there's anything to click. */
				background: rgba(20, 20, 20, 0.03);
			}
			.timeline-bar .seg {
				display: block;
				width: 100%;
			}
			/* Timeline medium buckets — validated categorical palette (gouache/watercolor/sketchbook
			   separate cleanly for colourblind viewers; see the dataviz palette check). `other` is a
			   neutral catch-all for pieces tagged with none of the three. */
			.seg-gouache {
				background: #b23a5a;
			}
			.seg-watercolor {
				background: #2f6fd0;
			}
			.seg-sketchbook {
				background: #b5732e;
			}
			.seg-other {
				background: #a9a295;
			}
			.timeline-axis {
				display: flex;
				gap: 2px;
				margin-top: 0.25rem;
				font-family: var(--mono);
				font-size: 0.65rem;
				color: var(--text-muted);
			}
			.timeline-axis .tick {
				flex: 1;
				min-width: 0;
				white-space: nowrap;
				text-align: center;
			}
			.timeline-month-group {
				margin-top: 0.5rem;
			}
			/* Breadcrumb: "All years › 2013 › May" — every ancestor level (.timeline-crumb) is a
			   plain-looking, underlined button that jumps straight to that level, styled identically
			   so the whole thing reads as one directory-like path rather than a button plus a
			   separate label. The current (deepest) segment is just text — nowhere shallower to jump
			   to from there. */
			.timeline-breadcrumb {
				margin: 0.5rem 0 0;
				font-family: var(--mono);
				font-size: 0.9rem;
			}
			.timeline-crumb {
				background: none;
				border: none;
				padding: 0;
				font: inherit;
				text-transform: none;
				cursor: pointer;
				text-decoration: underline;
				color: var(--text);
			}
			.timeline-crumb:hover {
				background: none;
				color: var(--pink);
			}
			#timeline-crumb-month {
				color: var(--text-muted);
			}
			.timeline-legend {
				display: flex;
				gap: 1rem;
				margin: 0.5rem 0 0;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.65rem;
				color: var(--text-muted);
			}
			.timeline-legend span {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}
			.timeline-legend .swatch {
				width: 0.75rem;
				height: 0.75rem;
				display: inline-block;
				border: 1px solid var(--border);
			}
			.timeline-month {
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				color: var(--text);
				margin: 1rem 0 0;
			}
			/* The timeline's month preview reuses the carousel look: the image sits in the shared
			   `.carousel-image` room, the caption below uses the carousel caption styling, and the
			   prev/next arrows are in a `.carousel-nav` row underneath — so it reads identically to
			   the home-page carousels. This just centres the caption link. */
			.timeline-caption {
				display: block;
				text-align: center;
				text-decoration: none;
				margin-top: 0.5rem;
			}

			/* leaflet.markercluster's own base CSS (its dist/MarkerCluster.css and
			   dist/MarkerCluster.Default.css) — inlined here rather than imported from the
			   package in mapPage.ts, working around a bundler quirk where that import silently
			   produced no CSS output at all (confirmed the import path itself resolves fine — a
			   deliberately wrong filename correctly errors the build — the real files' content
			   just never reached any emitted chunk). Dropped the vendor-prefixed transition
			   properties and the IE6-8 fallback color block from the originals; neither matters
			   for this site's actual browser support. Recolored the size-tier bubbles to the
			   site's own palette instead of the library's default green/yellow/orange scheme —
			   the library still owns all the actual clustering/positioning math (see
			   src/scripts/mapPage.ts), this is just a coat of paint on its existing markup. */
			.leaflet-cluster-anim .leaflet-marker-icon,
			.leaflet-cluster-anim .leaflet-marker-shadow {
				transition: transform 0.3s ease-out, opacity 0.3s ease-in;
			}
			.leaflet-cluster-spider-leg {
				transition: stroke-dashoffset 0.3s ease-out, stroke-opacity 0.3s ease-in;
			}
			.marker-cluster {
				background-clip: padding-box;
				border-radius: 20px;
			}
			.marker-cluster div {
				width: 30px;
				height: 30px;
				margin-left: 5px;
				margin-top: 5px;
				text-align: center;
				border-radius: 15px;
				font: 12px var(--mono);
			}
			.marker-cluster span {
				line-height: 30px;
			}
			.marker-cluster-small,
			.marker-cluster-medium,
			.marker-cluster-large {
				background-color: rgba(255, 61, 143, 0.25);
			}
			.marker-cluster-small div,
			.marker-cluster-medium div,
			.marker-cluster-large div {
				background-color: var(--pink);
				color: white;
				font-weight: 700;
				border: 2px solid var(--border);
			}

			figure {
				margin: 0 0 1rem 0;
			}
			figcaption {
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			details summary {
				cursor: pointer;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				font-weight: 700;
			}

			footer.debug {
				margin-top: 3rem;
				padding-top: 1rem;
				border-top: 1px solid var(--text-muted);
				font-family: var(--mono);
				font-size: 0.7rem;
				color: var(--text-muted);
				opacity: 0.6;
			}
			footer.debug a {
				/* Admin is tucked down here since only the owner ever clicks it — styled to blend
				   into the same muted debug text, not stand out as a normal bright link. */
				color: inherit;
			}
		</style>
	</head>
	<body>
		{!bare && (
		<header class="site-header">
			<a href="/" class="site-title">Lauria's Sketchbook</a>
			<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
			<label for="nav-toggle" class="nav-toggle-label"><span></span><span></span><span></span></label>
			<nav>
				<a href="/">Home</a>
				<a href="/kind/setup">My easel setup</a>
				<a href={`/tag/${encodeURIComponent('2026 sierra trip')}`}>High Sierra Trip</a>
				<a href={`/tag/${encodeURIComponent('brooklyn')}`}>Brooklyn</a>
				<a href={`/tag/${encodeURIComponent('2023 india trip')}`}>India Trip</a>
			</nav>
		</header>
		)}
		<slot />
		{!bare && (
		<footer class="debug" data-render-id={renderId}>
			rendered {renderedAt} · edge: {colo} · id: {renderId} · deployed {deployedAt} ({deployedCommit}) ·{' '}
			<a href="/admin">Admin</a> · <a href="/admin/new">Add new piece</a>
		</footer>
		)}
	</body>
</html>
