---
interface Props {
	title: string;
}
const { title } = Astro.props;

// Debug footer: if reloading the same URL keeps showing the same timestamp, that request was
// served from Cloudflare's edge cache, not re-rendered by the Worker. See docs/architecture.md's
// Cache policy section. `cf` is a Cloudflare-specific Request extension — absent under plain
// `astro dev`, present (real or emulated) under wrangler dev / deployed.
const renderedAt = new Date().toISOString();
const colo = (Astro.request as { cf?: { colo?: string } }).cf?.colo ?? 'local';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			:root {
				color-scheme: light dark;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
				--mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

				--bg: #f4f2ec;
				--panel: #ffffff;
				--text: #141414;
				--text-muted: #6b6b6b;
				--border: #141414;
				--pink: #ff3d8f;
				--purple: #7c5cff;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #141414;
					--panel: #1c1c1c;
					--text: #f4f2ec;
					--text-muted: #9a9a9a;
					--border: #f4f2ec;
					--pink: #ff5fa0;
					--purple: #a691ff;
				}
			}

			* {
				box-sizing: border-box;
			}
			body {
				margin: 0 auto;
				max-width: 64rem;
				padding: 1.5rem;
				line-height: 1.5;
				background: var(--bg);
				color: var(--text);
			}

			nav {
				display: flex;
				flex-wrap: wrap;
				border: 2px solid var(--border);
				margin-bottom: 1.5rem;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.05em;
			}
			nav a {
				padding: 0.6rem 1rem;
				color: var(--text);
				text-decoration: none;
				font-weight: 700;
				border-right: 2px solid var(--border);
			}
			nav a:last-child {
				border-right: none;
			}
			nav a:hover {
				background: var(--pink);
				color: white;
			}

			h1 {
				font-weight: 800;
				letter-spacing: -0.02em;
				text-transform: uppercase;
				border-bottom: 3px solid var(--border);
				padding-bottom: 0.5rem;
				margin-bottom: 1rem;
			}
			h2 {
				display: inline-block;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				background: var(--border);
				color: var(--bg);
				padding: 0.25rem 0.6rem;
				margin-bottom: 0.75rem;
			}

			section {
				border: 2px solid var(--border);
				background: var(--panel);
				padding: 1rem;
				margin-bottom: 1.5rem;
			}

			a {
				color: var(--purple);
			}
			a:hover {
				color: var(--pink);
			}

			em {
				color: var(--text-muted);
				font-style: normal;
				font-family: var(--mono);
				font-size: 0.85rem;
			}

			button,
			input[type='submit'] {
				background: var(--text);
				color: var(--bg);
				border: 2px solid var(--border);
				padding: 0.5rem 1rem;
				font-weight: 700;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				cursor: pointer;
			}
			button:hover,
			input[type='submit']:hover {
				background: var(--pink);
				border-color: var(--pink);
				color: white;
			}

			input[type='text'],
			input[type='date'],
			input[type='number'],
			input[type='email'],
			textarea,
			select {
				border: 2px solid var(--border);
				padding: 0.45rem 0.6rem;
				background: var(--panel);
				color: var(--text);
				font: inherit;
			}

			.tag-chip {
				background: var(--panel);
				color: var(--text);
				border: 2px solid var(--border);
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				font-weight: 700;
				padding: 0.3rem 0.6rem;
			}
			.tag-chip:hover {
				background: var(--purple);
				color: white;
				border-color: var(--purple);
			}

			img {
				border: 2px solid var(--border);
			}

			figure {
				margin: 0 0 1rem 0;
			}
			figcaption {
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.75rem;
				color: var(--text-muted);
			}

			details summary {
				cursor: pointer;
				font-family: var(--mono);
				text-transform: uppercase;
				font-size: 0.8rem;
				font-weight: 700;
			}

			footer.debug {
				margin-top: 3rem;
				padding-top: 1rem;
				border-top: 1px solid var(--text-muted);
				font-family: var(--mono);
				font-size: 0.7rem;
				color: var(--text-muted);
				opacity: 0.6;
			}
		</style>
	</head>
	<body>
		<nav>
			<a href="/">Home</a>
			<a href="/timeline">Timeline</a>
			<a href="/map">Map</a>
			<a href="/browse">Browse</a>
			<a href="/admin">Admin</a>
		</nav>
		<slot />
		<footer class="debug">rendered {renderedAt} · edge: {colo}</footer>
	</body>
</html>
