---
// The home page's timeline on its own, for framing in other sites (an <iframe> on klauria.tech).
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { getPieces } from '../../lib/data';
import { getPiecesByDateDescending } from '../../lib/facets';
import { setPageCacheHeaders } from '../../lib/cache';

setPageCacheHeaders(Astro.response.headers);

const { data } = await getPieces(env.ART_BUCKET);
const allByDate = getPiecesByDateDescending(data);
---

<Base title="Timeline · Lauria's Sketchbook" bare>
	{allByDate.length > 0 && <Timeline allByDate={allByDate} />}
</Base>
