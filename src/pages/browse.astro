---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import PieceThumb from '../components/PieceThumb.astro';
import { getPieces } from '../lib/data';
import { getPiecesByPlace } from '../lib/facets';
import { PAGE_CACHE_CONTROL } from '../lib/cache';

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const { data } = await getPieces(env.ART_BUCKET);
const byPlace = getPiecesByPlace(data);
---

<Base title="Browse by location">
	<h1>Browse by location</h1>
	<p><em>A plain, JS-free way to browse — see <a href="/map">the map</a> for the interactive version.</em></p>

	{byPlace.size === 0 ? (
		<p><em>Nothing uploaded yet.</em></p>
	) : (
		[...byPlace.entries()].map(([place, pieces]) => (
			<section>
				<h2>{place}</h2>
				<ul style="list-style:none; padding:0;">
					{pieces.map((piece) => (
						<li style="margin-bottom:0.5rem;">
							<a href={`/piece/${piece.id}`}><PieceThumb piece={piece} />{piece.title}</a> — {piece.date}
						</li>
					))}
				</ul>
			</section>
		))
	)}
</Base>
