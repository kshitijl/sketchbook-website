---
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import PieceThumb from '../components/PieceThumb.astro';
import { getPieces } from '../lib/data';
import { getPaintingStats, getRandomPieces } from '../lib/facets';
import { PAGE_CACHE_CONTROL } from '../lib/cache';
import type { Piece } from '../lib/types';

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const { data } = await getPieces(env.ART_BUCKET);
const paintingStats = getPaintingStats(data, new Date());

const favorites = data.pieces
	.filter((p): p is Piece & { favoriteRank: number } => p.favoriteRank !== null)
	.sort((a, b) => a.favoriteRank - b.favoriteRank);

const recent = [...data.pieces].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 12);
// Picked at render time, which — per the purge-on-write cache policy — only happens right after
// an edit or for the first visitor at a given edge location. So this is "a random pick that
// changes whenever you edit something," not "re-randomized on every single visit." That's an
// intentional trade against the caching model, not a bug: a truly per-visit random pick would
// mean rendering (and therefore not caching) this page on every request.
const rediscover = getRandomPieces(
	data.pieces,
	6,
	new Set(recent.map((p) => p.id))
);
---

<Base title="Sketches & paintings">
	<h1>Sketches &amp; paintings</h1>

	{data.pinnedLinks.length > 0 && (
		<p>
			{data.pinnedLinks.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</p>
	)}

	{paintingStats.lifetimeCount > 0 && (
		<section>
			<p>
				<strong>{paintingStats.lifetimeCount}</strong> paintings in your lifetime —{' '}
				<strong>{paintingStats.yearCount}</strong> of them in {paintingStats.year}.
				{paintingStats.remainingForYearMilestone > 0 && (
					<> {paintingStats.remainingForYearMilestone} more this year to hit {paintingStats.nextYearMilestone}.</>
				)}
			</p>
		</section>
	)}

	<section>
		<h2>Favorites</h2>
		{favorites.length === 0 ? (
			<p><em>No favorites marked yet.</em></p>
		) : (
			<ul style="list-style:none; padding:0;">
				{favorites.map((piece) => (
					<li style="margin-bottom:0.5rem;">
						<a href={`/piece/${piece.id}`}><PieceThumb piece={piece} />{piece.title}</a> — {piece.date}
					</li>
				))}
			</ul>
		)}
	</section>

	<section>
		<h2>Recent</h2>
		{recent.length === 0 ? (
			<p><em>Nothing uploaded yet.</em></p>
		) : (
			<ul style="list-style:none; padding:0;">
				{recent.map((piece) => (
					<li style="margin-bottom:0.5rem;">
						<a href={`/piece/${piece.id}`}><PieceThumb piece={piece} />{piece.title}</a> — {piece.date}
					</li>
				))}
			</ul>
		)}
	</section>

	{rediscover.length > 0 && (
		<section>
			<h2>Rediscover</h2>
			<ul style="list-style:none; padding:0;">
				{rediscover.map((piece) => (
					<li style="margin-bottom:0.5rem;">
						<a href={`/piece/${piece.id}`}><PieceThumb piece={piece} />{piece.title}</a> — {piece.date}
					</li>
				))}
			</ul>
		</section>
	)}
</Base>
