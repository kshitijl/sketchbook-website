---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getPieces } from '../../lib/data';
import { getAssetsByKind } from '../../lib/facets';
import { imageUrl } from '../../lib/images';
import { PAGE_CACHE_CONTROL } from '../../lib/cache';
import type { AssetKind } from '../../lib/types';

const VALID_KINDS: AssetKind[] = ['final', 'reference-photo', 'in-progress', 'value-study', 'setup'];

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const { kind } = Astro.params;
const isValidKind = (k: string | undefined): k is AssetKind =>
	!!k && (VALID_KINDS as string[]).includes(k);

if (!isValidKind(kind)) {
	Astro.response.status = 404;
}

const { data } = await getPieces(env.ART_BUCKET);
const results = isValidKind(kind) ? getAssetsByKind(data, kind) : [];
---

<Base title={isValidKind(kind) ? kind : 'Not found'}>
	{isValidKind(kind) ? (
		<>
			<h1>{kind}</h1>
			{results.length === 0 ? (
				<p><em>No assets of this kind yet.</em></p>
			) : (
				<ul style="list-style:none; padding:0;">
					{results.map(({ piece, asset }) => (
						<li style="margin-bottom:0.5rem;">
							<a href={`/piece/${piece.id}`}>
								<img
									src={imageUrl(asset.r2Key)}
									alt={asset.caption || piece.title}
									width="64"
									height="64"
									style="width:64px; height:64px; object-fit:cover; vertical-align:middle; margin-right:0.5rem; border-radius:2px;"
								/>{piece.title}
							</a>
							{asset.caption ? ` — ${asset.caption}` : ''} ({piece.date})
						</li>
					))}
				</ul>
			)}
		</>
	) : (
		<p>Unknown asset kind.</p>
	)}
</Base>
