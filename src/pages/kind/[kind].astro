---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getPieces } from '../../lib/data';
import { getAssetsByKind } from '../../lib/facets';
import { imageUrl } from '../../lib/images';
import { ASSET_KIND_FIELDS } from '../../lib/assetKinds';
import { PAGE_CACHE_CONTROL } from '../../lib/cache';
import type { AssetKind } from '../../lib/types';

// Derived from the same source as the admin form's asset fields, so a new kind added there is
// automatically valid here too — nothing to keep in sync by hand.
const VALID_KINDS: AssetKind[] = ASSET_KIND_FIELDS.map((f) => f.kind);

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const { kind } = Astro.params;
const isValidKind = (k: string | undefined): k is AssetKind =>
	!!k && (VALID_KINDS as string[]).includes(k);

if (!isValidKind(kind)) {
	Astro.response.status = 404;
}

const { data } = await getPieces(env.ART_BUCKET);
const results = isValidKind(kind) ? getAssetsByKind(data, kind) : [];
---

<Base title={isValidKind(kind) ? kind : 'Not found'}>
	{isValidKind(kind) ? (
		<>
			<h1>{kind}</h1>
			{results.length === 0 ? (
				<p><em>No assets of this kind yet.</em></p>
			) : (
				<ul class="piece-grid large">
					{results.map(({ piece, asset }) => (
						<li>
							<a href={`/piece/${piece.id}`}>
								<img src={imageUrl(asset.r2Key, 'card')} alt={asset.caption || piece.title} loading="lazy" />
								<span class="caption">
									{piece.title}{asset.caption ? ` — ${asset.caption}` : ''} — {piece.date}
								</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</>
	) : (
		<p>Unknown asset kind.</p>
	)}
</Base>
