---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getPieces, updatePieces } from '../../lib/data';
import { getTagFrequency } from '../../lib/facets';
import { generateAssetId, generatePieceId, buildAssetKey } from '../../lib/ids';
import { getImageDimensions } from '../../lib/imageDimensions';
import { getVariantFiles } from '../../lib/images';
import { purgePages } from '../../lib/purge';
import { isAuthorizedAdminRequest } from '../../lib/adminGuard';
import { backupAsset, backupPieceData, logBackupEvent } from '../../lib/backup';
import { ASSET_KINDS } from '../../lib/assetKinds';
import type { Asset, AssetKind, Piece, Stage } from '../../lib/types';

Astro.response.headers.set('Cache-Control', 'no-store');

const { data: currentData } = await getPieces(env.ART_BUCKET);
const tagFrequency = getTagFrequency(currentData);

const todayISO = new Date().toISOString().slice(0, 10);

const errors: string[] = [];
let values = {
	title: '',
	date: todayISO,
	stage: 'finished' as Stage,
	lat: '',
	lng: '',
	placeName: '',
	tags: '',
	notes: ''
};

if (Astro.request.method === 'POST') {
	if (!isAuthorizedAdminRequest(Astro.request, env)) {
		return new Response('Forbidden', { status: 403 });
	}

	const formData = await Astro.request.formData();

	values = {
		title: String(formData.get('title') ?? '').trim(),
		date: String(formData.get('date') ?? '').trim(),
		stage: formData.get('stage') === 'study' ? 'study' : 'finished',
		lat: String(formData.get('lat') ?? '').trim(),
		lng: String(formData.get('lng') ?? '').trim(),
		placeName: String(formData.get('placeName') ?? '').trim(),
		tags: String(formData.get('tags') ?? '').trim(),
		notes: String(formData.get('notes') ?? '').trim()
	};

	const lat = Number(values.lat);
	const lng = Number(values.lng);

	if (!values.title) errors.push('Title is required.');
	if (!values.date) errors.push('Date is required.');
	if (!values.placeName) errors.push('Place name is required.');
	if (values.lat === '' || Number.isNaN(lat)) errors.push('Location is required — click the map or use your current location.');
	if (values.lng === '' || Number.isNaN(lng)) errors.push('Location is required — click the map or use your current location.');

	const finalFile = formData.get('asset_final');
	if (!(finalFile instanceof File) || finalFile.size === 0) {
		errors.push('An image is required.');
	}

	// The <input accept="image/*"> is only a client-side hint, not a real restriction — check
	// every provided file server-side too, so a wrong file type fails clearly instead of silently
	// uploading something an <img> tag can't display.
	for (const { field, label } of [
		{ field: 'asset_final', label: 'Final piece' },
		{ field: 'asset_extra', label: 'Additional photos' }
	]) {
		for (const file of formData.getAll(field)) {
			if (file instanceof File && file.size > 0 && !file.type.startsWith('image/')) {
				errors.push(`${label}: "${file.name}" doesn't look like an image (${file.type || 'unknown type'}).`);
			}
		}
	}

	// Every uploaded image must arrive with its three client-generated WebP variants (see
	// pieceForm.ts). Without them there's nothing to display — a hard error, not a silent
	// master-only record (e.g. if JavaScript didn't run in the browser).
	if (finalFile instanceof File && finalFile.size > 0 && !getVariantFiles(formData, (s) => `asset_final_${s}`)) {
		errors.push('Resized image versions are missing — is JavaScript enabled? They’re generated in the browser before upload.');
	}
	const extraForCheck = formData.getAll('asset_extra');
	for (let i = 0; i < extraForCheck.length; i++) {
		const f = extraForCheck[i];
		if (f instanceof File && f.size > 0 && !getVariantFiles(formData, (s) => `asset_extra_${s}_${i}`)) {
			errors.push(`Additional photo #${i + 1}: resized versions are missing (is JavaScript enabled?).`);
		}
	}

	if (errors.length === 0) {
		const tags = values.tags
			.split(',')
			.map((t) => t.trim().toLowerCase())
			.filter(Boolean);

		// Id generation only needs to peek at current ids, not hold a lock — the tiny residual
		// risk of a collision with a concurrent write is an acceptable trade for a single editor.
		const existingIds = new Set(currentData.pieces.map((p) => p.id));
		const newId = generatePieceId(values.title, values.date, existingIds);

		// Upload images under real, versioned keys before touching pieces.json — no placeholder
		// values needed since the id is already known.
		const assets: Asset[] = [];
		const existingAssetIds = new Set<string>();
		let imagesBackedUp = 0;
		const backupErrors: string[] = [];

		async function uploadAsset(file: File, kind: AssetKind, variants: { thumb: File; card: File; big: File }) {
			const assetId = generateAssetId(existingAssetIds);
			existingAssetIds.add(assetId);
			const ext = (file.name.split('.').pop() || 'bin').toLowerCase();
			const r2Key = buildAssetKey(newId, assetId, ext);
			const buffer = await file.arrayBuffer();
			const dims = getImageDimensions(new Uint8Array(buffer));
			const contentType = file.type || 'application/octet-stream';
			await env.ART_BUCKET.put(r2Key, buffer, { httpMetadata: { contentType } });
			// Best-effort: a backup failure must never break the actual upload it's shadowing,
			// but it should still show up in the visible log rather than being fully silent. Only the
			// master is backed up — the variants below are regenerable derivatives.
			try {
				await backupAsset(env.BACKUP_BUCKET, r2Key, buffer, contentType);
				imagesBackedUp++;
			} catch (err) {
				backupErrors.push(`Failed to back up ${r2Key}: ${String(err)}`);
			}
			// Store the three pre-generated WebP variants (generated client-side, see pieceForm.ts).
			const sizes = { thumb: '', card: '', big: '' };
			for (const size of ['thumb', 'card', 'big'] as const) {
				const key = buildAssetKey(newId, `${assetId}-${size}`, 'webp');
				await env.ART_BUCKET.put(key, await variants[size].arrayBuffer(), { httpMetadata: { contentType: 'image/webp' } });
				sizes[size] = key;
			}
			assets.push({ id: assetId, kind, r2Key, sizes, width: dims?.width ?? 0, height: dims?.height ?? 0 });
		}

		if (finalFile instanceof File && finalFile.size > 0) {
			await uploadAsset(finalFile, 'final', getVariantFiles(formData, (s) => `asset_final_${s}`)!);
		}

		// Each "additional photo" is tagged right at selection time — a `kind_extra_<i>` select
		// added client-side (see pieceForm.ts) next to its preview, indexed to match the order
		// files appear in the multi-file input — instead of always landing as `unsorted` and
		// needing a second trip to the edit page just to tag it.
		const extraFiles = formData.getAll('asset_extra');
		for (let i = 0; i < extraFiles.length; i++) {
			const file = extraFiles[i];
			if (!(file instanceof File) || file.size === 0) continue;
			const kindValue = formData.get(`kind_extra_${i}`);
			const kind: AssetKind =
				typeof kindValue === 'string' && (ASSET_KINDS as string[]).includes(kindValue)
					? (kindValue as AssetKind)
					: 'unsorted';
			await uploadAsset(file, kind, getVariantFiles(formData, (s) => `asset_extra_${s}_${i}`)!);
		}

		const piece: Piece = {
			id: newId,
			title: values.title,
			date: values.date,
			stage: values.stage,
			location: { lat, lng, placeName: values.placeName },
			tags,
			notes: values.notes,
			favoriteRank: null,
			assets
		};

		const saved = await updatePieces(env.ART_BUCKET, (data) => {
			data.pieces.push(piece);
		});
		let metadataSnapshotTaken = false;
		try {
			await backupPieceData(env.BACKUP_BUCKET, saved);
			metadataSnapshotTaken = true;
		} catch (err) {
			backupErrors.push(`Failed to back up metadata: ${String(err)}`);
		}
		await logBackupEvent(env.BACKUP_BUCKET, {
			kind: 'on-write',
			ranAt: new Date().toISOString(),
			action: 'Uploaded new piece',
			pieceTitle: piece.title,
			imagesBackedUp,
			metadataSnapshotTaken,
			errors: backupErrors
		}).catch(() => {});
		await purgePages();

		// `?added=1` only ever shows up on this specific redirect — it's how the piece page knows to
		// show the "Add another piece" shortcut, since right after adding one you're often adding
		// another and don't want to re-navigate to /admin every time.
		return Astro.redirect(`/piece/${newId}?added=1`);
	}
}
---

<Base title="Add a new piece">
	<h1>Add a new piece</h1>

	{errors.length > 0 && (
		<ul style="color:var(--accent-3);">
			{errors.map((error) => (
				<li>{error}</li>
			))}
		</ul>
	)}

	<form method="POST" enctype="multipart/form-data">
		<p>
			<label>
				<strong>Select image</strong><br />
				<input
					type="file"
					id="finalImageInput"
					class="asset-preview-input"
					data-preview-id="finalImagePreview"
					name="asset_final"
					accept="image/*"
					required
				/>
			</label>
			<!-- Populated client-side (pieceForm.ts) with the pre-generated WebP variants. -->
			<input type="file" class="final-variant" data-size="thumb" name="asset_final_thumb" hidden />
			<input type="file" class="final-variant" data-size="card" name="asset_final_card" hidden />
			<input type="file" class="final-variant" data-size="big" name="asset_final_big" hidden />
		</p>
		<p>
			<img id="finalImagePreview" alt="Preview" style="display:none; max-width:320px; max-height:320px;" />
		</p>

		<p>
			<label>Title<br /><input type="text" id="titleInput" name="title" value={values.title} required /></label>
		</p>
		<p>
			<label>Date<br /><input type="date" id="dateInput" name="date" value={values.date} required /></label>
		</p>
		<p>
			<label>Stage<br />
				<select name="stage">
					<option value="finished" selected={values.stage === 'finished'}>Finished</option>
					<option value="study" selected={values.stage === 'study'}>Study / sketch</option>
				</select>
			</label>
		</p>

		<p>
			<strong>Location</strong><br />
			<input type="hidden" id="latInput" name="lat" value={values.lat} />
			<input type="hidden" id="lngInput" name="lng" value={values.lng} />
			<input type="text" id="locationSearchInput" placeholder="Search for a place (e.g. Prospect Park)" />
			<button type="button" id="locationSearchBtn">Search</button>
			<br />
			<button type="button" id="useCurrentLocationBtn">Use my current location</button>
			<span id="locationReadout">No location selected yet — click the map, search, or use the button above.</span>
			<span id="locationSearchStatus" style="display:block; color:var(--text-muted); font-size:0.85rem;"></span>
			<div id="locationMap" style="height:70vh; min-height:480px; margin-top:0.5rem;"></div>
		</p>
		<p>
			<label>Place name<br /><input type="text" id="placeNameInput" name="placeName" value={values.placeName} required placeholder="e.g. Jaipur, India" /></label>
		</p>

		<p>
			<label>Tags (comma-separated)<br /><textarea id="tagsInput" name="tags" rows="3" style="width:100%;">{values.tags}</textarea></label>
		</p>
		{tagFrequency.length > 0 && (
			<p>
				{tagFrequency.map(({ tag, count }) => (
					<button type="button" class="tag-chip" data-tag={tag} style="margin:0 0.25rem 0.25rem 0;">
						{tag} ({count})
					</button>
				))}
			</p>
		)}

		<p>
			<label>Notes<br /><textarea name="notes" rows="4" cols="50">{values.notes}</textarea></label>
		</p>

		<details>
			<summary>Additional photos (optional) — reference, in-progress, value study, setup, whatever</summary>
			<p>
				<em>Select as many as you want, then tag each one right below.</em>
			</p>
			<p>
				<input type="file" id="extraAssetInput" name="asset_extra" accept="image/*" multiple />
			</p>
			<div id="extraAssetList"></div>
		</details>

		<p><button type="submit">Save</button></p>
	</form>
</Base>

<script>
	import { setupPieceForm } from '../../scripts/pieceForm';
	// No initial lat/lng — auto-fires geolocation on load since this is a brand-new piece.
	setupPieceForm({ autoUseCurrentLocation: true });
</script>
