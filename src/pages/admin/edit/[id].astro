---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import { getPieces, updatePieces } from '../../../lib/data';
import { getPieceById, getTagFrequency } from '../../../lib/facets';
import { generateAssetId, buildAssetKey } from '../../../lib/ids';
import { getImageDimensions } from '../../../lib/imageDimensions';
import { ASSET_KIND_LABELS, ASSET_KINDS } from '../../../lib/assetKinds';
import { imageUrl } from '../../../lib/images';
import { purgeEverything } from '../../../lib/purge';
import { isAuthorizedAdminRequest } from '../../../lib/adminGuard';
import { backupAsset, backupPieceData, logBackupEvent } from '../../../lib/backup';
import type { AssetKind, Stage } from '../../../lib/types';

// Every kind except `final` — that one has its own dedicated single-slot section below, not a
// per-asset kind selector, since a piece always has at most one and it's not just another tag.
const OTHER_KINDS = ASSET_KINDS.filter((k) => k !== 'final');

Astro.response.headers.set('Cache-Control', 'no-store');

const { id } = Astro.params;
const { data } = await getPieces(env.ART_BUCKET);
const piece = id ? getPieceById(data, id) : undefined;

if (!piece) {
	Astro.response.status = 404;
}

const tagFrequency = piece ? getTagFrequency(data) : [];

const errors: string[] = [];
let values = piece
	? {
			title: piece.title,
			date: piece.date,
			stage: piece.stage,
			lat: String(piece.location.lat),
			lng: String(piece.location.lng),
			placeName: piece.location.placeName,
			tags: piece.tags.join(', '),
			notes: piece.notes
		}
	: {
			title: '',
			date: '',
			stage: 'finished' as Stage,
			lat: '',
			lng: '',
			placeName: '',
			tags: '',
			notes: ''
		};

if (piece && Astro.request.method === 'POST') {
	if (!isAuthorizedAdminRequest(Astro.request, env)) {
		return new Response('Forbidden', { status: 403 });
	}

	const formData = await Astro.request.formData();

	if (formData.get('intent') === 'delete') {
		// Only the JSON pointer entry is removed here — the underlying R2 image objects are never
		// deleted by this app (intentionally; see docs/architecture.md's Backups section), so
		// there's nothing to un-delete even without a backup for this specific action. Still back
		// up the resulting metadata document, same as any other write.
		const saved = await updatePieces(env.ART_BUCKET, (d) => {
			d.pieces = d.pieces.filter((p) => p.id !== piece.id);
		});
		const deleteBackupErrors: string[] = [];
		let deleteMetadataSnapshotTaken = false;
		try {
			await backupPieceData(env.BACKUP_BUCKET, saved);
			deleteMetadataSnapshotTaken = true;
		} catch (err) {
			deleteBackupErrors.push(`Failed to back up metadata: ${String(err)}`);
		}
		await logBackupEvent(env.BACKUP_BUCKET, {
			kind: 'on-write',
			ranAt: new Date().toISOString(),
			action: 'Deleted piece',
			pieceTitle: piece.title,
			imagesBackedUp: 0,
			metadataSnapshotTaken: deleteMetadataSnapshotTaken,
			errors: deleteBackupErrors
		}).catch(() => {});
		await purgeEverything();
		return Astro.redirect('/admin');
	}

	values = {
		title: String(formData.get('title') ?? '').trim(),
		date: String(formData.get('date') ?? '').trim(),
		stage: formData.get('stage') === 'study' ? 'study' : 'finished',
		lat: String(formData.get('lat') ?? '').trim(),
		lng: String(formData.get('lng') ?? '').trim(),
		placeName: String(formData.get('placeName') ?? '').trim(),
		tags: String(formData.get('tags') ?? '').trim(),
		notes: String(formData.get('notes') ?? '').trim()
	};

	const lat = Number(values.lat);
	const lng = Number(values.lng);

	if (!values.title) errors.push('Title is required.');
	if (!values.date) errors.push('Date is required.');
	if (!values.placeName) errors.push('Place name is required.');
	if (values.lat === '' || Number.isNaN(lat)) errors.push('Location is required.');
	if (values.lng === '' || Number.isNaN(lng)) errors.push('Location is required.');

	// The <input accept="image/*"> is only a client-side hint, not a real restriction — check
	// every provided file server-side too, so a wrong file type fails clearly instead of silently
	// uploading something an <img> tag can't display.
	for (const { field, label } of [
		{ field: 'asset_final', label: 'Final piece' },
		{ field: 'asset_extra', label: 'Additional photos' }
	]) {
		for (const file of formData.getAll(field)) {
			if (file instanceof File && file.size > 0 && !file.type.startsWith('image/')) {
				errors.push(`${label}: "${file.name}" doesn't look like an image (${file.type || 'unknown type'}).`);
			}
		}
	}

	if (errors.length === 0) {
		const tags = values.tags
			.split(',')
			.map((t) => t.trim().toLowerCase())
			.filter(Boolean);

		// Assets are a bag of images tagged by kind, not one slot per kind — a piece can have
		// several reference photos, setup shots, etc. Three independent kinds of change, applied
		// in order below: remove, re-kind (tagging an `unsorted` upload after the fact), add.
		type AssetUpdate =
			| { action: 'remove'; assetId: string }
			| { action: 'kind'; assetId: string; kind: AssetKind }
			| { action: 'add'; kind: AssetKind; assetId: string; r2Key: string; width: number; height: number };
		const assetUpdates: AssetUpdate[] = [];

		for (const asset of piece.assets) {
			if (formData.get(`remove_asset_${asset.id}`) === 'on') {
				assetUpdates.push({ action: 'remove', assetId: asset.id });
				continue;
			}
			if (asset.kind === 'final') continue;
			const newKind = formData.get(`kind_${asset.id}`);
			if (typeof newKind === 'string' && newKind !== asset.kind && (ASSET_KINDS as string[]).includes(newKind)) {
				assetUpdates.push({ action: 'kind', assetId: asset.id, kind: newKind as AssetKind });
			}
		}

		let imagesBackedUp = 0;
		const backupErrors: string[] = [];
		const existingAssetIds = new Set(piece.assets.map((a) => a.id));
		const pieceId = piece.id;

		async function uploadAsset(file: File, kind: AssetKind) {
			const assetId = generateAssetId(existingAssetIds);
			existingAssetIds.add(assetId);
			const ext = (file.name.split('.').pop() || 'bin').toLowerCase();
			const r2Key = buildAssetKey(pieceId, assetId, ext);
			const buffer = await file.arrayBuffer();
			const dims = getImageDimensions(new Uint8Array(buffer));
			const contentType = file.type || 'application/octet-stream';
			await env.ART_BUCKET.put(r2Key, buffer, { httpMetadata: { contentType } });
			// Best-effort: a backup failure must never break the actual upload it's shadowing,
			// but it should still show up in the visible log rather than being fully silent.
			try {
				await backupAsset(env.BACKUP_BUCKET, r2Key, buffer, contentType);
				imagesBackedUp++;
			} catch (err) {
				backupErrors.push(`Failed to back up ${r2Key}: ${String(err)}`);
			}
			assetUpdates.push({ action: 'add', kind, assetId, r2Key, width: dims?.width ?? 0, height: dims?.height ?? 0 });
		}

		const finalFile = formData.get('asset_final');
		if (finalFile instanceof File && finalFile.size > 0) {
			await uploadAsset(finalFile, 'final');
		}

		// Each newly-added "additional photo" is tagged right at selection time — a
		// `kind_extra_<i>` select added client-side (see pieceForm.ts) next to its preview,
		// indexed to match the order files appear in the multi-file input — instead of always
		// landing as `unsorted`. (The `kind_<assetId>` selects above are a separate mechanism, for
		// re-tagging assets from a *previous* submission.)
		const extraFiles = formData.getAll('asset_extra');
		for (let i = 0; i < extraFiles.length; i++) {
			const file = extraFiles[i];
			if (!(file instanceof File) || file.size === 0) continue;
			const kindValue = formData.get(`kind_extra_${i}`);
			const kind: AssetKind =
				typeof kindValue === 'string' && (ASSET_KINDS as string[]).includes(kindValue)
					? (kindValue as AssetKind)
					: 'unsorted';
			await uploadAsset(file, kind);
		}

		const saved = await updatePieces(env.ART_BUCKET, (d) => {
			const p = d.pieces.find((pp) => pp.id === piece.id);
			if (!p) return;
			p.title = values.title;
			p.date = values.date;
			p.stage = values.stage;
			p.location = { lat, lng, placeName: values.placeName };
			p.tags = tags;
			p.notes = values.notes;

			const removeIds = new Set(assetUpdates.filter((u) => u.action === 'remove').map((u) => u.assetId));
			p.assets = p.assets.filter((a) => !removeIds.has(a.id));

			const kindChanges = new Map(
				assetUpdates.filter((u) => u.action === 'kind').map((u) => [u.assetId, u.kind])
			);
			for (const asset of p.assets) {
				const newKind = kindChanges.get(asset.id);
				if (newKind) asset.kind = newKind;
			}

			for (const update of assetUpdates) {
				if (update.action === 'add') {
					p.assets.push({
						id: update.assetId,
						kind: update.kind,
						r2Key: update.r2Key,
						width: update.width,
						height: update.height
					});
				}
			}
		});
		let metadataSnapshotTaken = false;
		try {
			await backupPieceData(env.BACKUP_BUCKET, saved);
			metadataSnapshotTaken = true;
		} catch (err) {
			backupErrors.push(`Failed to back up metadata: ${String(err)}`);
		}
		await logBackupEvent(env.BACKUP_BUCKET, {
			kind: 'on-write',
			ranAt: new Date().toISOString(),
			action: 'Edited piece',
			pieceTitle: piece.title,
			imagesBackedUp,
			metadataSnapshotTaken,
			errors: backupErrors
		}).catch(() => {});
		await purgeEverything();

		return Astro.redirect(`/piece/${piece.id}`);
	}
}
---

<Base title={piece ? `Edit: ${piece.title}` : 'Not found'}>
	{!piece ? (
		<p>Piece not found.</p>
	) : (
		<>
			<h1>Edit: {piece.title}</h1>

			{errors.length > 0 && (
				<ul style="color:var(--accent-3);">
					{errors.map((error) => (
						<li>{error}</li>
					))}
				</ul>
			)}

			<form method="POST" enctype="multipart/form-data">
				<p>
					<label>Title<br /><input type="text" id="titleInput" name="title" value={values.title} required /></label>
				</p>
				<p>
					<label>Date<br /><input type="date" id="dateInput" name="date" value={values.date} required /></label>
				</p>
				<p>
					<label>Stage<br />
						<select name="stage">
							<option value="finished" selected={values.stage === 'finished'}>Finished</option>
							<option value="study" selected={values.stage === 'study'}>Study / sketch</option>
						</select>
					</label>
				</p>

				<p>
					<strong>Location</strong><br />
					<input type="hidden" id="latInput" name="lat" value={values.lat} />
					<input type="hidden" id="lngInput" name="lng" value={values.lng} />
					<input type="text" id="locationSearchInput" placeholder="Search for a place (e.g. Prospect Park)" />
					<button type="button" id="locationSearchBtn">Search</button>
					<br />
					<button type="button" id="useCurrentLocationBtn">Use my current location</button>
					<span id="locationReadout">Selected: {values.lat}, {values.lng}</span>
					<span id="locationSearchStatus" style="display:block; color:var(--text-muted); font-size:0.85rem;"></span>
					<div id="locationMap" style="height:70vh; min-height:480px; margin-top:0.5rem;"></div>
				</p>
				<p>
					<label>Place name<br /><input type="text" id="placeNameInput" name="placeName" value={values.placeName} required /></label>
				</p>

				<p>
					<label>Tags (comma-separated)<br /><input type="text" id="tagsInput" name="tags" value={values.tags} /></label>
				</p>
				{tagFrequency.length > 0 && (
					<p>
						{tagFrequency.map(({ tag, count }) => (
							<button type="button" class="tag-chip" data-tag={tag} style="margin:0 0.25rem 0.25rem 0;">
								{tag} ({count})
							</button>
						))}
					</p>
				)}

				<p>
					<label>Notes<br /><textarea name="notes" rows="4" cols="50">{values.notes}</textarea></label>
				</p>

				<h2>Photos</h2>

				<div style="margin-bottom:1rem; padding:0.5rem; border:1px solid #ccc;">
					<strong>{ASSET_KIND_LABELS.final}</strong><br />
					{(() => {
						const finalAsset = piece.assets.find((a) => a.kind === 'final');
						return (
							<>
								{finalAsset && (
									<div style="margin:0.5rem 0;">
										<img
											src={imageUrl(finalAsset.r2Key, 'thumb')}
											alt={ASSET_KIND_LABELS.final}
											style="max-width:200px; max-height:200px; display:block;"
										/>
										<label><input type="checkbox" name={`remove_asset_${finalAsset.id}`} /> Remove this image</label>
									</div>
								)}
								<label>
									{finalAsset ? 'Replace with' : 'Add'} image:
									<input
										type="file"
										id="finalImageInput"
										class="asset-preview-input"
										data-preview-id="preview-final"
										name="asset_final"
										accept="image/*"
									/>
								</label>
								<br />
								<img id="preview-final" alt="New preview" style="display:none; max-width:200px; max-height:200px; margin-top:0.5rem;" />
							</>
						);
					})()}
				</div>

				<div style="margin-bottom:1rem; padding:0.5rem; border:1px solid #ccc;">
					<strong>Other photos</strong><br />
					<p><em>Tag each one below — reference photo, in-progress, value study, setup, whatever it is.</em></p>
					{piece.assets
						.filter((a) => a.kind !== 'final')
						.map((asset) => (
							<div style="margin:0.75rem 0; display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
								<img
									src={imageUrl(asset.r2Key, 'thumb')}
									alt={ASSET_KIND_LABELS[asset.kind]}
									style="max-width:120px; max-height:120px; display:block;"
								/>
								<label>
									Kind:
									<select name={`kind_${asset.id}`}>
										{OTHER_KINDS.map((k) => (
											<option value={k} selected={asset.kind === k}>{ASSET_KIND_LABELS[k]}</option>
										))}
									</select>
								</label>
								<label><input type="checkbox" name={`remove_asset_${asset.id}`} /> Remove</label>
							</div>
						))}
					<label>
						Add more photos (you can select more than one), then tag each below:
						<input type="file" id="extraAssetInput" name="asset_extra" accept="image/*" multiple />
					</label>
					<div id="extraAssetList"></div>
				</div>

				<p><button type="submit">Save</button></p>
			</form>

			<form method="POST" style="margin-top:2rem;">
				<input type="hidden" name="intent" value="delete" />
				<button type="submit" data-confirm="Delete this piece? This cannot be undone.">Delete this piece</button>
			</form>
		</>
	)}
</Base>

<script>
	import { setupPieceForm } from '../../../scripts/pieceForm';

	const latInput = document.getElementById('latInput') as HTMLInputElement | null;
	const lngInput = document.getElementById('lngInput') as HTMLInputElement | null;
	const initialLat = latInput?.value ? Number(latInput.value) : undefined;
	const initialLng = lngInput?.value ? Number(lngInput.value) : undefined;

	setupPieceForm({
		initialLat: Number.isFinite(initialLat) ? initialLat : undefined,
		initialLng: Number.isFinite(initialLng) ? initialLng : undefined
	});

	document.querySelectorAll<HTMLButtonElement>('button[data-confirm]').forEach((btn) => {
		btn.addEventListener('click', (e) => {
			const message = btn.dataset.confirm;
			if (message && !confirm(message)) {
				e.preventDefault();
			}
		});
	});
</script>
