---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PieceThumb from '../../components/PieceThumb.astro';
import { getPieces, updatePieces } from '../../lib/data';
import { compareDatesDescending } from '../../lib/facets';
import { purgePages } from '../../lib/purge';
import { isAuthorizedAdminRequest } from '../../lib/adminGuard';
import { backupPieceData, logBackupEvent } from '../../lib/backup';

Astro.response.headers.set('Cache-Control', 'no-store');

if (Astro.request.method === 'POST') {
	if (!isAuthorizedAdminRequest(Astro.request, env)) {
		return new Response('Forbidden', { status: 403 });
	}

	const formData = await Astro.request.formData();
	// One repeated hidden input per favorited piece, in DOM order — which the browser reproduces
	// as submission order for repeated form fields. Dragging a piece's <li> around in the browser
	// is enough on its own to change this; no rank numbers to type or renumber.
	const orderedIds = formData.getAll('favorite_order').map(String);

	const saved = await updatePieces(env.ART_BUCKET, (data) => {
		for (const piece of data.pieces) {
			const idx = orderedIds.indexOf(piece.id);
			piece.favoriteRank = idx === -1 ? null : idx + 1;
		}
	});
	let metadataSnapshotTaken = false;
	const backupErrors: string[] = [];
	try {
		await backupPieceData(env.BACKUP_BUCKET, saved);
		metadataSnapshotTaken = true;
	} catch (err) {
		backupErrors.push(`Failed to back up metadata: ${String(err)}`);
	}
	await logBackupEvent(env.BACKUP_BUCKET, {
		kind: 'on-write',
		ranAt: new Date().toISOString(),
		action: 'Reordered favorites',
		imagesBackedUp: 0,
		metadataSnapshotTaken,
		errors: backupErrors
	}).catch(() => {});
	await purgePages();

	return Astro.redirect('/admin/favorites');
}

const { data } = await getPieces(env.ART_BUCKET);
const favorites = data.pieces
	.filter((p) => p.favoriteRank != null)
	.sort((a, b) => (a.favoriteRank ?? 0) - (b.favoriteRank ?? 0));
const rest = data.pieces
	.filter((p) => p.favoriteRank == null)
	.sort((a, b) => compareDatesDescending(a.date, b.date));
---

<Base title="Reorder favorites">
	<h1>Reorder favorites</h1>
	<p>
		<em>Drag a favorite by its handle (⠿) to reorder. Use the button on each piece to add or remove it as a favorite.</em>
	</p>

	<form method="POST">
		<p class="section-label">Favorites</p>
		<ul id="favList" class="fav-list">
			{favorites.map((piece) => (
				<li data-id={piece.id}>
					<span class="drag-handle">⠿</span>
					<input type="hidden" name="favorite_order" value={piece.id} />
					<PieceThumb piece={piece} size={48} />
					<a href={`/piece/${piece.id}`}>{piece.title}</a>
					<span class="muted">— {piece.date}</span>
					<button type="button" class="toggle-fav">Remove</button>
				</li>
			))}
		</ul>
		{favorites.length === 0 && <p><em>No favorites yet — add some below.</em></p>}

		<p class="section-label">Everything else</p>
		<ul id="restList" class="fav-list">
			{rest.map((piece) => (
				<li data-id={piece.id}>
					<PieceThumb piece={piece} size={48} />
					<a href={`/piece/${piece.id}`}>{piece.title}</a>
					<span class="muted">— {piece.date}</span>
					<button type="button" class="toggle-fav">★ Favorite</button>
				</li>
			))}
		</ul>

		<button type="submit">Save order</button>
	</form>
</Base>

<style>
	.fav-list {
		list-style: none;
		padding: 0;
	}
	.fav-list li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		background: var(--bg);
		touch-action: none;
	}
	.fav-list li.dragging {
		opacity: 0.5;
	}
	.drag-handle {
		cursor: grab;
		color: var(--text-muted);
		font-size: 1.2rem;
		padding: 0 0.25rem;
	}
	.muted {
		color: var(--text-muted);
	}
	.toggle-fav {
		margin-left: auto;
	}
</style>

<script>
	const favList = document.getElementById('favList') as HTMLUListElement;
	const restList = document.getElementById('restList') as HTMLUListElement;

	// Moving a piece between the two lists is just moving its <li> — the hidden
	// `favorite_order` input (present only inside favList's rows) travels with it, and its
	// absence/presence there is exactly what determines favorite status on submit.
	document.querySelectorAll<HTMLButtonElement>('.toggle-fav').forEach((btn) => {
		btn.addEventListener('click', () => {
			const li = btn.closest('li');
			if (!li) return;
			if (li.parentElement === favList) {
				li.querySelector('input[name="favorite_order"]')?.remove();
				const handle = li.querySelector('.drag-handle');
				handle?.remove();
				btn.textContent = '★ Favorite';
				restList.appendChild(li);
			} else {
				const handle = document.createElement('span');
				handle.className = 'drag-handle';
				handle.textContent = '⠿';
				li.insertBefore(handle, li.firstChild);
				const input = document.createElement('input');
				input.type = 'hidden';
				input.name = 'favorite_order';
				input.value = li.dataset.id ?? '';
				li.insertBefore(input, li.querySelector('img'));
				btn.textContent = 'Remove';
				favList.appendChild(li);
			}
		});
	});

	// Pointer-based drag reorder within favList (works for mouse and touch alike, unlike native
	// HTML5 drag-and-drop which iOS Safari doesn't support) — grab the handle, then on move, swap
	// the dragged <li> with whichever sibling the pointer is currently over.
	let dragging: HTMLLIElement | null = null;

	favList.addEventListener('pointerdown', (e) => {
		const target = e.target as HTMLElement;
		if (!target.classList.contains('drag-handle')) return;
		const li = target.closest('li');
		if (!li) return;
		dragging = li;
		li.classList.add('dragging');
		li.setPointerCapture(e.pointerId);
	});

	favList.addEventListener('pointermove', (e) => {
		if (!dragging) return;
		const target = document.elementFromPoint(e.clientX, e.clientY);
		const over = target?.closest('li');
		if (!over || over === dragging || over.parentElement !== favList) return;
		const rect = over.getBoundingClientRect();
		const before = e.clientY < rect.top + rect.height / 2;
		favList.insertBefore(dragging, before ? over : over.nextSibling);
	});

	function stopDragging() {
		dragging?.classList.remove('dragging');
		dragging = null;
	}
	favList.addEventListener('pointerup', stopDragging);
	favList.addEventListener('pointercancel', stopDragging);
</script>
