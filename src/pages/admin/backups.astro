---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import BackupLog from '../../components/BackupLog.astro';
import { getRecentBackupLog, countBackupSnapshots, BACKUP_SNAPSHOTS_PREFIX } from '../../lib/backup';

Astro.response.headers.set('Cache-Control', 'no-store');

const recentBackupLog = await getRecentBackupLog(env.BACKUP_BUCKET, 50);
const totalSnapshots = await countBackupSnapshots(env.BACKUP_BUCKET);

const listing = await env.BACKUP_BUCKET.list({ prefix: BACKUP_SNAPSHOTS_PREFIX, limit: 1000 });
const recentSnapshotKeys = listing.objects
	.map((o) => o.key)
	.sort()
	.reverse()
	.slice(0, 20);

const lastReconciliation = recentBackupLog.find((e) => e.kind === 'reconciliation');
const hoursSinceLastReconciliation = lastReconciliation
	? (Date.now() - new Date(lastReconciliation.ranAt).getTime()) / (1000 * 60 * 60)
	: null;
// The reconciliation job runs daily — flag as stale if it hasn't run in noticeably longer than a
// day, which usually means the Cron Trigger itself stopped firing rather than a run failing (a
// failed run still writes a log entry with its errors listed).
const isStale = hoursSinceLastReconciliation === null || hoursSinceLastReconciliation > 30;
---

<Base title="Backups">
	<h1>Backups</h1>

	<section>
		<h2>Daily reconciliation check</h2>
		{!lastReconciliation ? (
			<p>
				<em>No reconciliation run recorded yet — the daily job (backup-worker/) hasn't run for
				the first time. Expected until its first scheduled tick.</em>
			</p>
		) : (
			<p>
				<strong style={isStale ? 'color:var(--accent-3);' : 'color:var(--purple);'}>
					{isStale ? 'STALE' : 'Healthy'}
				</strong>
				{' — last ran '}
				{hoursSinceLastReconciliation !== null ? `${Math.round(hoursSinceLastReconciliation)}h ago` : 'unknown'}
			</p>
		)}
	</section>

	<section>
		<h2>Recent backup activity — last {recentBackupLog.length}</h2>
		<BackupLog entries={recentBackupLog} />
	</section>

	<section>
		<h2>Metadata snapshots</h2>
		<p>
			<em>
				A full copy of the metadata document is saved on every edit, plus once a day by the
				reconciliation job — every snapshot is kept, none are ever deleted.
			</em>
		</p>
		{recentSnapshotKeys.length === 0 ? (
			<p><em>No snapshots yet.</em></p>
		) : (
			<ul>
				{recentSnapshotKeys.map((key) => <li>{key}</li>)}
			</ul>
		)}
		<p><em>{totalSnapshots} total snapshot{totalSnapshots === 1 ? '' : 's'} kept.</em></p>
	</section>
</Base>
