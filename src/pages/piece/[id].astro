---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getPieces } from '../../lib/data';
import { getPieceById, getPrimaryAsset, orderAssetsFinalFirst } from '../../lib/facets';
import { imageUrl } from '../../lib/images';
import { PAGE_CACHE_CONTROL } from '../../lib/cache';

Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

const { id } = Astro.params;
const { data } = await getPieces(env.ART_BUCKET);
const piece = id ? getPieceById(data, id) : undefined;

if (!piece) {
	Astro.response.status = 404;
}

const orderedAssets = piece ? orderAssetsFinalFirst(piece.assets) : [];

// Open Graph needs an absolute image URL — derived from the current request's own origin so it's
// correct whether this is served from workers.dev or the eventual custom domain.
const primaryAsset = piece ? getPrimaryAsset(piece) : undefined;
const ogImage = primaryAsset ? new URL(imageUrl(primaryAsset.r2Key), Astro.url).toString() : undefined;
const ogDescription = piece
	? piece.notes || `${piece.date} · ${piece.stage} · ${piece.location.placeName}`
	: undefined;
---

<Base title={piece ? piece.title : 'Not found'} description={ogDescription} image={ogImage}>
	{piece ? (
		<article>
			<h1>{piece.title}</h1>
			<p>
				{piece.date} · {piece.stage} · {piece.location.placeName}
				{' · '}<a href={`/admin/edit/${piece.id}`}>Edit</a>
			</p>
			<p>
				{piece.tags.map((tag) => (
					<a href={`/tag/${tag}`}>#{tag}</a>
				))}
			</p>

			{orderedAssets.map((asset) => (
				<figure style="margin:0 0 1rem 0;">
					<img
						src={imageUrl(asset.r2Key)}
						alt={asset.caption || `${piece.title} (${asset.kind})`}
						width={asset.width || undefined}
						height={asset.height || undefined}
						style="max-width:100%; max-height:85vh; width:auto; height:auto;"
					/>
					<figcaption>{asset.kind}{asset.caption ? ` — ${asset.caption}` : ''}</figcaption>
				</figure>
			))}

			{piece.notes && <p>{piece.notes}</p>}
		</article>
	) : (
		<p>Piece not found.</p>
	)}
</Base>
