---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { getPieces } from '../../lib/data';
import { getPieceById, getPrimaryAsset, orderAssetsFinalFirst } from '../../lib/facets';
import { imageUrl, originalImageUrl, SIZE_WIDTHS } from '../../lib/images';
import { setPageCacheHeaders } from '../../lib/cache';

setPageCacheHeaders(Astro.response.headers);

const { id } = Astro.params;
const { data } = await getPieces(env.ART_BUCKET);
const piece = id ? getPieceById(data, id) : undefined;

if (!piece) {
	Astro.response.status = 404;
}

const orderedAssets = piece ? orderAssetsFinalFirst(piece.assets) : [];

// Only ever true right after /admin/new's own redirect. Does two things, both admin-only and
// never shown to other viewers (nothing else ever links here with this param): shows an "add
// another piece" shortcut, and visibly renders every asset's thumb/card size right here — the
// only page that would otherwise ever request those sizes for a brand-new upload is /admin, which
// isn't necessarily the very next page visited. This surfaces a broken resize (see docs/TODO.md's
// "Bug: an error-status Images response..." entry) immediately, as a visibly broken image, rather
// than relying on stumbling across it later.
const justAdded = Astro.url.searchParams.get('added') === '1';

// Open Graph needs an absolute image URL — derived from the current request's own origin so it's
// correct whether this is served from workers.dev or the eventual custom domain.
const primaryAsset = piece ? getPrimaryAsset(piece) : undefined;
const ogImage = primaryAsset ? new URL(imageUrl(primaryAsset, 'card'), Astro.url).toString() : undefined;
const ogDescription = piece
	? piece.notes || `${piece.date} · ${piece.stage} · ${piece.location.placeName}`
	: undefined;
---

<Base title={piece ? piece.title : 'Not found'} description={ogDescription} image={ogImage}>
	{piece ? (
		<article>
			{justAdded && <p><a href="/admin/new"><strong>&larr; Add another piece</strong></a></p>}
			<h1>{piece.title}</h1>
			<p>
				{piece.date} · {piece.stage} · {piece.location.placeName}
				{' · '}<a href={`/admin/edit/${piece.id}`}>Edit</a>
			</p>
			<p>
				{piece.tags.map((tag) => (
					<a href={`/tag/${tag}`} style="margin-right:0.6rem;">#{tag}</a>
				))}
			</p>

			{orderedAssets.map((asset) => (
				<figure style="margin:0 0 1rem 0;">
					<img
						src={imageUrl(asset, 'big')}
						alt={asset.caption || `${piece.title} (${asset.kind})`}
						width={asset.width || undefined}
						height={asset.height || undefined}
						style="max-width:100%; max-height:85vh; width:auto; height:auto;"
					/>
					<figcaption>
						{asset.kind}{asset.caption ? ` — ${asset.caption}` : ''}
						{' — '}<a href={originalImageUrl(asset.r2Key)}>View full resolution</a>
					</figcaption>
					{justAdded && (
						<div class="added-check">
							{[
								{ label: 'original', url: originalImageUrl(asset.r2Key), width: asset.width || undefined },
								{ label: 'big', url: imageUrl(asset, 'big'), width: SIZE_WIDTHS.big },
								{ label: 'card', url: imageUrl(asset, 'card'), width: SIZE_WIDTHS.card },
								{ label: 'thumb', url: imageUrl(asset, 'thumb'), width: SIZE_WIDTHS.thumb }
							].map((v) => (
								<figure class="added-variant">
									<figcaption>{v.label} ({v.width ? `${v.width}px` : 'full'}): <span class="added-size" data-size-for={v.url}>measuring…</span></figcaption>
									<img src={v.url} alt={`${v.label} check`} loading="eager" width={v.width} />
								</figure>
							))}
						</div>
					)}
				</figure>
			))}

			{piece.notes && <p>{piece.notes}</p>}
		</article>
	) : (
		<p>Piece not found.</p>
	)}
</Base>

{justAdded && (
	<style>
		/* Stacked, each variant shown at its actual pixel width (capped to the viewport) so you can
		   judge how it really looks at the size the site serves it — not shrunk to a thumbnail. */
		.added-check {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			margin: 0.5rem 0 0;
			padding: 0.75rem;
			border: 1px dashed var(--text-muted);
		}
		.added-variant {
			margin: 0;
		}
		.added-variant img {
			display: block;
			max-width: 100%;
			height: auto;
		}
		.added-variant figcaption {
			font-family: var(--mono);
			font-size: 0.7rem;
			color: var(--text-muted);
			margin-bottom: 0.3rem;
			word-break: break-word;
		}
	</style>
	<script is:inline>
		// Post-add diagnostic: fill in each variant's actual delivered size + content-type so a bad
		// upload (e.g. an oversized original serving as image/png instead of a resized webp) is
		// obvious at a glance. Reads headers only, then cancels the body — the <img> already loads it.
		(function () {
			function fmt(n) {
				if (n >= 1048576) return (n / 1048576).toFixed(2) + ' MB';
				if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
				return n + ' B';
			}
			document.querySelectorAll('.added-size').forEach(function (el) {
				var url = el.getAttribute('data-size-for');
				fetch(url)
					.then(function (res) {
						var ct = res.headers.get('content-type') || '?';
						var len = res.headers.get('content-length');
						if (len) {
							// Header present (always the case in production) — read it and skip the body.
							if (res.body) res.body.cancel();
							el.textContent = fmt(Number(len)) + ' · ' + ct;
						} else {
							// No content-length (e.g. local dev's streamed resizes) — measure the body.
							return res.blob().then(function (b) {
								el.textContent = fmt(b.size) + ' · ' + ct;
							});
						}
					})
					.catch(function () {
						el.textContent = 'failed to load';
					});
			});
		})();
	</script>
)}
