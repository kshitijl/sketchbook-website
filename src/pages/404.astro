---
import Base from '../layouts/Base.astro';
import { PAGE_CACHE_CONTROL } from '../lib/cache';

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
---

<Base title="Not found">
	<h1>Not found</h1>
	<p>There's nothing at this address. Try <a href="/">home</a> — the map and timeline both live there now.</p>
</Base>
