---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PieceList from '../../components/PieceList.astro';
import { getPieces } from '../../lib/data';
import { getPiecesByTag } from '../../lib/facets';
import { setPageCacheHeaders } from '../../lib/cache';

setPageCacheHeaders(Astro.response.headers);

const { slug } = Astro.params;
const { data } = await getPieces(env.ART_BUCKET);
const pieces = slug ? getPiecesByTag(data, slug) : [];
// ?sort=asc reverses the default newest-first order to oldest-first — for e.g. "first marks",
// linked from the intro blurb, where the point is watching things unfold chronologically.
if (Astro.url.searchParams.get('sort') === 'asc') pieces.reverse();
---

<Base title={`#${slug}`}>
	<h1>#{slug}</h1>
	{pieces.length === 0 ? (
		<p><em>No pieces tagged #{slug} yet.</em></p>
	) : (
		<>
			<p><em>{pieces.length} piece{pieces.length === 1 ? '' : 's'}</em></p>
			<PieceList pieces={pieces} large />
		</>
	)}
</Base>
