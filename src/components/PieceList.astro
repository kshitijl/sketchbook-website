---
import { getPrimaryAsset } from '../lib/facets';
import { imageUrl } from '../lib/images';
import type { Piece } from '../lib/types';

interface Props {
	pieces: Piece[];
	/** Bigger cards, fewer per row — for the top-of-page gallery. */
	large?: boolean;
	/** Forces the first piece to span the full row as a big opening image. Only meaningful with
	 * `large`, and only meant for the page's actual first gallery — pass this on more than one
	 * batch on the same page and every one of them independently "restarts" the big-then-smaller
	 * pattern, which reads as a broken/inconsistent size rather than a deliberate opening beat. */
	heroFirst?: boolean;
}
const { pieces, large = false, heroFirst = false } = Astro.props;
---

<ul class:list={['piece-grid', { large, 'hero-first': heroFirst }]}>
	{pieces.map((piece, index) => {
		const asset = getPrimaryAsset(piece);
		// The hero-first opening image renders much larger on screen (spans the full row) than
		// an ordinary card, so it needs the bigger source to still look sharp.
		const size = heroFirst && index === 0 ? 'big' : 'card';
		return (
			<li>
				<a href={`/piece/${piece.id}`}>
					{asset && <img src={imageUrl(asset.r2Key, size)} alt={piece.title} loading="lazy" />}
					<span class="caption">{piece.title} — {piece.date}</span>
				</a>
			</li>
		);
	})}
</ul>
