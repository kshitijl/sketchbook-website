---
import { getPrimaryAsset } from '../lib/facets';
import { imageUrl } from '../lib/images';
import type { Piece } from '../lib/types';

interface Props {
	piece: Piece;
	size?: number;
}
const { piece, size = 64 } = Astro.props;
const asset = getPrimaryAsset(piece);
---

{asset && (
	<img
		src={imageUrl(asset.r2Key)}
		alt={piece.title}
		width={size}
		height={size}
		style={`width:${size}px; height:${size}px; object-fit:cover; vertical-align:middle; margin-right:0.5rem; border-radius:2px;`}
	/>
)}
